  "targets": [
    {
      "metric": "Device completion",
      "target": "≥90%",
      "measurement": "Independently add the correct light to the correct room; successful unassisted tasks / all device-task attempts."
    },
    {
      "metric": "Device setup time",
      "target": "≤90s median",
      "measurement": "Discovery screen displayed to named confirmation; report successful-attempt median and failed attempts separately."
    },
    {
      "metric": "Room completion",
      "target": "≥95%",
      "measurement": "Correct room name, selected photo and intended devices saved / all room-task attempts."
    },
    {
      "metric": "Scene completion",
      "target": "≥85%",
      "measurement": "Correct scene membership AND all requested ON/OFF states saved / all scene-task attempts."
    },
    {
      "metric": "Scene time",
      "target": "≤120s median",
      "measurement": "Choose-scene screen displayed to scene-added confirmation; successful-attempt median."
    },
    {
      "metric": "Device control access",
      "target": "1–2 taps",
      "measurement": "From Home to the requested supported appliance control, excluding the adjustment itself. Verify category routing in an interactive prototype."
    },
    {
      "metric": "Post-task confidence",
      "target": "≥4.2/5 mean",
      "measurement": "Immediately rate confidence that the intended change is correct, 1 not at all to 5 completely; report sample size and distribution."
    },
    {
      "metric": "Setup abandonment",
      "target": "≤10%",
      "measurement": "Device setups explicitly cancelled or with no terminal success for 10 minutes / setup starts. Deduplicate resumed attempts by session ID; separate crashes and observed study failures."
    }
  ]
