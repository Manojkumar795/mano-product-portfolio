  "heuristic": {
    "name": "Visible control evidence",
    "scale": "0 = absent from supplied frame; 1 = partial; 2 = explicit. Four criteria, maximum 8. This is an evidence coverage score, not a usability or compliance score.",
    "criteria": [
      {
        "id": "identity",
        "rubric": "2: room and appliance named; 1: only one named; 0: neither."
      },
      {
        "id": "power",
        "rubric": "2: power text plus switch; 1: only text or switch; 0: neither."
      },
      {
        "id": "range",
        "rubric": "2: current primary numeric value, unit and explicit bounds; 1: value and unit without bounds; 0: no numeric feedback."
      },
      {
        "id": "alternative",
        "rubric": "2: visible non-drag alternative for primary continuous value; 1: hint of alternative without visible control; 0: none visible."
      }
    ],
